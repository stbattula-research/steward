# Steward settings. The setup wizard (Start Steward.command) creates .env from this file.
# .env holds your keys: it is chmod 600 and git-ignored. Never commit it.

OWNER_NAME=
AGENT_NAME=Steward
TIMEZONE=America/Chicago

# Brain: ollama | anthropic | ollama-cloud | custom
BRAIN_PROVIDER=ollama
# ollama: any local model with tool calling (the wizard picks one for your RAM)
OLLAMA_MODEL=gemma4:12b
# Model memory in tokens (bigger = longer tasks, more RAM). 65536 suits 16 GB Macs.
OLLAMA_CONTEXT_LENGTH=65536
# anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# ollama-cloud / custom (Anthropic-compatible endpoint)
BRAIN_BASE_URL=
BRAIN_API_KEY=
BRAIN_MODEL=
# Optional: the hosted model's context window in tokens, so long tasks get summarised in time
BRAIN_CONTEXT_TOKENS=

# Telegram (optional): bot token from @BotFather, your numeric id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- Optional ------------------------------------------------------------------
# Desktop app. Avatar is a bot-avatars type: droid, clover, cat, ghost, cloud, star, mech, alien, blob, pill
AGENT_AVATAR=droid
WEB_PORT=8765
OPEN_APP_ON_START=false

# Always-on: watchlist check interval in minutes (0 = off), and hours with no heads-up pings
HEARTBEAT_MINUTES=60
QUIET_HOURS=22-7

# Limits and safety. MAX_BUDGET_USD applies to the anthropic brain only.
MAX_TURNS=60
MAX_BUDGET_USD=2.0
APPROVE_PASSWORDS=true
APPROVAL_TIMEOUT_SEC=600
VERBOSE_STEPS=false

# Voice notes (on-device Whisper, Apple Silicon)
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Browser for web tasks: chrome | msedge | chromium (set automatically if Chrome isn't installed)
BROWSER_CHANNEL=chrome
